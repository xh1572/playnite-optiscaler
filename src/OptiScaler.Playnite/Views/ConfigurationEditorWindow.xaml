<Window x:Class="OptiScaler.Playnite.Views.ConfigurationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OptiScaler.Playnite.Views"
        Title="OptiScaler.ini" Width="1000" Height="760" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="OptiScaler.ini 配置" Style="{StaticResource TitleText}" />
            <TextBlock Text="可视化页面按配置节分组显示全部键值；原始文本页保留完整文件内容。" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Profile toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Profile" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0"
                           ToolTip="从插件数据目录加载一个已保存的 OptiScaler.ini profile。" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileNames, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding SelectedProfile, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="选择要加载或删除的 profile。" />
                <Button Grid.Column="2" Click="LoadProfile_Click" Margin="8,0,0,0" ToolTip="把选中的 profile 载入当前编辑器。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0,0,8,0" />
                        <TextBlock Text="加载" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Click="DeleteProfile_Click" Margin="4,0,0,0" ToolTip="删除选中的 profile 文件。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" Margin="0,0,8,0" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </Button>
                <TextBox Grid.Column="5" Text="{Binding ProfileName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                         Tag="新 profile 名称" ToolTip="保存为新的 profile 名称" />
                <Button Grid.Column="6" Click="SaveProfile_Click" Margin="8,0,0,0" ToolTip="使用左侧名称保存当前配置，供其他游戏安装时套用。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,0,8,0" />
                        <TextBlock Text="保存为 profile" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="可视化配置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="搜索配置键或当前值" Padding="30,0,9,0" ToolTip="搜索配置键或当前值" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="11,0,0,0" HorizontalAlignment="Left"
                                   Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="True" ToolTip="{Binding Name}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                <TextBlock Text="{Binding Name, StringFormat=[{0}]}" Style="{StaticResource CaptionText}" Margin="10,1,0,0" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding SettingsView}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="280" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <local:HelpLabel Text="{Binding DisplayName}" Description="{Binding ToolTip}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" />
                                                            <TextBlock Text="{Binding Key}" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                        <Grid Grid.Column="1" MaxWidth="420" HorizontalAlignment="Left" MinWidth="260">
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                                <ComboBox.Style>
                                                                    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.Style>
                                                            </ComboBox>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="原始文本">
                <TextBox x:Name="ConfigurationTextBox" Style="{StaticResource CodeTextBox}" AcceptsReturn="True" AcceptsTab="True"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button Content="保存" IsDefault="True" Click="Save_Click" MinWidth="88" Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
