<UserControl x:Class="OptiScaler.Playnite.Views.OptiScalerSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OptiScaler.Playnite.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
             FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Quick-config field: label on top, editor below, fixed width so rows align. -->
            <Style x:Key="FieldPanel" TargetType="{x:Type StackPanel}">
                <Setter Property="Width" Value="168" />
                <Setter Property="Margin" Value="0,0,12,12" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="{x:Type local:HelpLabel}" BasedOn="{StaticResource {x:Type local:HelpLabel}}">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,44,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding EditGameListCommand}" Margin="0,0,8,0" ToolTip="从 Playnite 已安装游戏中选择要显示和管理的游戏。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" Margin="0,0,8,0" />
                        <TextBlock Text="编辑游戏列表" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" ToolTip="重新读取 Playnite 的已安装游戏并检查 OptiScaler 状态。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSubtleBrush}"
                        BorderBrush="{StaticResource AccentSubtleBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7F4;" FontSize="18" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OptiScaler 管理" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding GameListModeText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Release and package source -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="版本频道" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                <TextBlock Grid.Column="1" Text="可用版本" Style="{StaticResource CaptionText}" Margin="10,0,0,5" />
                <TextBlock Grid.Column="5" Text="当前安装包" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ReleaseChannels}" SelectedItem="{Binding ReleaseChannel}" ToolTip="版本频道：稳定版、Beta 测试版或 Nightly 每日版。切换后会立即保存。" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" Margin="10,0,0,0"
                          Tag="点击“检查更新”获取版本列表" ToolTip="选择要下载的 OptiScaler 版本。" />
                <Button Grid.Row="1" Grid.Column="2" Command="{Binding CheckReleasesCommand}" Margin="10,0,0,0" ToolTip="从 OptiScaler 发布频道刷新版本信息。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" Margin="0,0,8,0" />
                        <TextBlock Text="检查更新" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="3" Command="{Binding DownloadReleaseCommand}" Margin="8,0,0,0" ToolTip="下载当前选中的 OptiScaler 安装包并缓存到本机。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" Margin="0,0,8,0" />
                        <TextBlock Text="下载" />
                    </StackPanel>
                </Button>
                <Border Grid.RowSpan="2" Grid.Column="4" Width="1" Background="{StaticResource DividerBrush}" Margin="18,0" />
                <DockPanel Grid.Row="1" Grid.Column="5" VerticalAlignment="Center" ToolTip="{Binding PackagePath}">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE7B8;" Margin="0,0,8,0">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#7D89A4" />
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding PackageFileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackage}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <Button Grid.Row="1" Grid.Column="6" Command="{Binding ChoosePackageCommand}" Margin="12,0,0,0" ToolTip="选择本地的 zip 或 7z 安装包。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,0,8,0" />
                        <TextBlock Text="选择本地包" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <!-- Game list and detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="搜索游戏" Padding="30,0,9,0" ToolTip="按名称搜索已安装的游戏。" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="11,0,0,0" HorizontalAlignment="Left"
                                   Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <DockPanel Grid.Row="1" Margin="2,0,0,8">
                        <ComboBox DockPanel.Dock="Right" Width="118" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" ToolTip="按 OptiScaler 安装状态筛选游戏。" />
                        <TextBlock Text="{Binding GameCountText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Initial letter sits under the Playnite icon and shows when no icon is available. -->
                                    <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="8" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Style="{StaticResource StatusBadge}">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                Visibility="{Binding ShowEmptyList, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7FC;" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding EmptyListText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" MaxWidth="240" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid DataContext="{Binding SelectedGame}"
                          Visibility="{Binding DataContext.HasSelectedGame, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Game header -->
                        <Border Padding="22,18,18,16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="在资源管理器中打开该游戏的安装目录。">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,0,8,0" />
                                        <TextBlock Text="打开目录" />
                                    </StackPanel>
                                </Button>
                                <Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <Border CornerRadius="10" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="10">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <WrapPanel Margin="0,7,0,0">
                                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding InjectionText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DetailsText}" Style="{StaticResource OptionalCaption}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding InstallDirectory}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallDirectory}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="22,16,14,6">
                                <StackPanel Margin="0,0,0,16" Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="检测到的组件" Style="{StaticResource GroupTitleText}" />
                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipBorder}">
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="快速配置" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                                    <TextBlock Margin="12,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Text" Value="安装 OptiScaler 后才能保存；注入方式和 profile 会在安装时使用。" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEditConfiguration}" Value="True">
                                                        <Setter Property="Text" Value="修改后点击“保存快速配置”写入该游戏的 OptiScaler.ini。" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="超分" Style="{StaticResource GroupTitleText}" />
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="DX11" Description="选择 DX11 游戏使用的超分方案。auto 使用 OptiScaler 默认值；也可以指定 FSR、XeSS 或 DLSS。" />
                                        <ComboBox ItemsSource="{Binding DataContext.UpscalerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Dx11Upscaler, UpdateSourceTrigger=PropertyChanged}" ToolTip="DX11 游戏的默认超分方案。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="DX12" Description="选择 DX12 游戏使用的超分方案。auto 使用 OptiScaler 默认值，当前常见默认值为 XeSS。" />
                                        <ComboBox ItemsSource="{Binding DataContext.UpscalerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Dx12Upscaler, UpdateSourceTrigger=PropertyChanged}" ToolTip="DX12 游戏的默认超分方案。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="Vulkan" Description="选择 Vulkan 游戏使用的超分方案。auto 使用 OptiScaler 默认值。" />
                                        <ComboBox ItemsSource="{Binding DataContext.UpscalerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding VulkanUpscaler, UpdateSourceTrigger=PropertyChanged}" ToolTip="Vulkan 游戏的默认超分方案。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="超分比例" Description="启用内部渲染分辨率覆盖；启用后才会使用下方的比例值。" />
                                        <ComboBox ItemsSource="{Binding DataContext.BooleanOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding UpscaleRatioEnabled, UpdateSourceTrigger=PropertyChanged}" ToolTip="UpscaleRatio.UpscaleRatioOverrideEnabled：启用超分比例覆盖。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="比例值" Description="强制超分比例值。auto 使用游戏默认值，常见默认值为 1.3。" />
                                        <TextBox Text="{Binding UpscaleRatioValue, UpdateSourceTrigger=PropertyChanged}" Tag="auto" ToolTip="UpscaleRatio.UpscaleRatioOverrideValue：强制超分比例，默认 1.3。" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Text="帧生成" Style="{StaticResource GroupTitleText}" />
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="帧生成" Description="是否启用帧生成。需要游戏本身支持并在游戏内开启；auto 使用 OptiScaler 默认行为。" />
                                        <ComboBox ItemsSource="{Binding DataContext.FrameGenerationOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding FrameGeneration, UpdateSourceTrigger=PropertyChanged}" ToolTip="FrameGen.Enabled：启用或关闭帧生成。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="输入" Description="选择帧生成输入来源。auto 跟随游戏检测结果，nofg 表示关闭帧生成输入。" />
                                        <ComboBox ItemsSource="{Binding DataContext.FrameGenerationInputOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding FrameGenerationInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="FrameGen.FGInput：选择帧生成输入来源。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="输出" Description="选择生成帧的输出方式。auto 由 OptiScaler 选择，具体选项要与游戏和硬件兼容。" />
                                        <ComboBox ItemsSource="{Binding DataContext.FrameGenerationOutputOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding FrameGenerationOutput, UpdateSourceTrigger=PropertyChanged}" ToolTip="FrameGen.FGOutput：选择帧生成输出方式。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="HUD 修复" Description="启用 FSR 3.1 帧生成的 HUD 修复。部分游戏或 Async 路径可能崩溃，遇到问题请恢复为 auto。" />
                                        <ComboBox ItemsSource="{Binding DataContext.BooleanOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding HudFix, UpdateSourceTrigger=PropertyChanged}" ToolTip="OptiFG.HUDFix：启用 HUD 修复。" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="输出缩放" Style="{StaticResource GroupTitleText}" />
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="输出缩放" Description="启用输出缩放，在超分完成后把图像缩放到目标输出分辨率。" />
                                        <ComboBox ItemsSource="{Binding DataContext.BooleanOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding OutputScaling, UpdateSourceTrigger=PropertyChanged}" ToolTip="OutputScaling.Enabled：启用输出缩放。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="倍率" Description="输出缩放倍率，支持 0.5 到 3.0。auto 使用默认倍率，通常为 1.5。" />
                                        <TextBox Text="{Binding OutputScalingMultiplier, UpdateSourceTrigger=PropertyChanged}" Tag="auto" ToolTip="OutputScaling.Multiplier：输出缩放倍率，范围 0.5 - 3.0。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="缩放器" Description="输出缩放使用的算法：0 FSR1，1 Bicubic，2 Catmull-Rom，3 Lanczos2，4 Lanczos3，5 Kaiser2，6 Kaiser3，7 MAGIC。" />
                                        <ComboBox ItemsSource="{Binding DataContext.OutputScalingDownscalerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding OutputScalingDownscaler, UpdateSourceTrigger=PropertyChanged}" ToolTip="OutputScaling.Downscaler：选择输出缩放算法。" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Text="FSR4 与兼容性" Style="{StaticResource GroupTitleText}" />
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="FSR4 更新" Description="将 FSR 3.x 调用更新为 FSR4。auto 会根据 GPU 决定，RDNA4 通常默认启用。" />
                                        <ComboBox ItemsSource="{Binding DataContext.BooleanOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Fsr4Update, UpdateSourceTrigger=PropertyChanged}" ToolTip="FSR.Fsr4Update：将 FSR3.x 更新为 FSR4。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="FSR4 模型" Description="选择 FSR4 模型：0 原生 AA，1 Ultra Quality/Quality，2 Balanced，3 Performance，4 DRS，5 Ultra Performance。" />
                                        <ComboBox ItemsSource="{Binding DataContext.Fsr4ModelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Fsr4Model, UpdateSourceTrigger=PropertyChanged}" ToolTip="FSR.Fsr4Model：选择 FSR4 模型。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="GPU 伪装" Description="把 GPU 报告为 NVIDIA，使 AMD/Intel 可以运行 DLSS-only 游戏。auto 会按硬件自动决定。" />
                                        <ComboBox ItemsSource="{Binding DataContext.BooleanOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding GpuSpoofing, UpdateSourceTrigger=PropertyChanged}" ToolTip="Spoofing.Dxgi：启用 DXGI GPU 伪装。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="ASI 插件" Description="允许 OptiScaler 从 plugins 文件夹加载 .asi 插件。只在需要相关插件时启用。" />
                                        <ComboBox ItemsSource="{Binding DataContext.BooleanOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding LoadAsiPlugins, UpdateSourceTrigger=PropertyChanged}" ToolTip="Plugins.LoadAsiPlugins：加载 plugins 文件夹中的 ASI 插件。" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Text="安装选项" Style="{StaticResource GroupTitleText}" />
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource FieldPanel}">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="注入方式" Description="选择 OptiScaler 注入游戏的代理 DLL。通常使用 dxgi.dll；如果游戏无法识别，再尝试其他方式。" />
                                        <ComboBox ItemsSource="{Binding DataContext.InjectionMethods, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding InjectionMethod, UpdateSourceTrigger=PropertyChanged}" ToolTip="选择注入 DLL。默认推荐 dxgi.dll。" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldPanel}" Width="348">
                                        <local:HelpLabel Style="{StaticResource FieldLabel}" Text="安装时套用 profile" Description="选择一个已保存的 OptiScaler.ini profile，在安装或更新时覆盖安装包中的配置。留空则使用安装包自带配置。" />
                                        <ComboBox ItemsSource="{Binding DataContext.ProfileNames, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空则使用安装包自带配置；选择 profile 后会在安装时套用。" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Action bar -->
                        <Border Grid.Row="2" Padding="22,12,18,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="按安装 manifest 恢复备份并移除由插件安装的文件。">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" Margin="0,0,8,0" />
                                        <TextBlock Text="卸载" />
                                    </StackPanel>
                                </Button>
                                <WrapPanel>
                                    <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" MinWidth="120"
                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="把选中的 OptiScaler 版本安装到该游戏，或按 manifest 更新现有安装。">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" Margin="0,0,8,0" />
                                            <TextBlock Text="安装 / 更新" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding DataContext.SaveQuickConfigurationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="把当前快速配置写入该游戏的 OptiScaler.ini。">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,0,8,0" />
                                            <TextBlock Text="保存快速配置" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="打开 OptiScaler.ini 的可视化和原始文本编辑器。">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Margin="0,0,8,0" />
                                            <TextBlock Text="详细配置" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedGame, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7FC;" FontSize="34" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="在左侧选择一个游戏" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="查看 OptiScaler 状态、安装或调整配置。" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Status strip -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource DividerBrush}" />
            <ProgressBar Style="{StaticResource BusyBar}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel Grid.Row="1" Margin="2,8,2,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding PackagePath}" Style="{StaticResource CaptionText}" MaxWidth="620"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PackagePath}" Margin="16,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding OperationText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
