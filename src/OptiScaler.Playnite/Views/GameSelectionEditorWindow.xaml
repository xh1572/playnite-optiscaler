<Window x:Class="OptiScaler.Playnite.Views.GameSelectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 OptiScaler 游戏列表"
        Width="760" Height="680" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Rows toggle their checkbox on click, so the selection highlight is not needed. -->
            <Style x:Key="SelectionRow" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Focusable" Value="False" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="OptiScaler 游戏列表" Style="{StaticResource TitleText}" />
            <TextBlock Text="选择要在侧边栏中管理的已安装 Playnite 游戏。" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox Content="启用自定义列表" FontWeight="SemiBold"
                          IsChecked="{Binding UseCustomList, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="关闭时侧边栏显示全部已安装游戏；启用后只显示下面勾选的游戏。" />
                <TextBlock Text="关闭时侧边栏显示全部已安装游戏；启用后只显示下面勾选的游戏。" Style="{StaticResource CaptionText}" Margin="28,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="按名称或安装目录搜索" Padding="30,0,9,0" ToolTip="按游戏名称或安装目录搜索。" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="11,0,0,0" HorizontalAlignment="Left"
                                   Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="14,0,10,0" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="全选" Click="SelectAll_Click" ToolTip="选中当前 Playnite 已安装游戏列表中的全部项目。" />
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="清空" Click="Clear_Click" Margin="2,0,0,0" ToolTip="取消选择全部项目；保存后自定义列表可以为空。" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding GamesView}" ItemContainerStyle="{StaticResource SelectionRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding InstallDirectory}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button Content="保存" IsDefault="True" Click="Save_Click" MinWidth="88" Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
